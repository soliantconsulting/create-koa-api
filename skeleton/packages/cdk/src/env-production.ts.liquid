import { App } from "aws-cdk-lib";
import { ApiStack } from "./api-stack.js";

const app = new App();

throw new Error("Production env not configured");

// biome-ignore lint/correctness/noUnreachable: env not configured
new ApiStack(app, "{{project.name}}-production", {
    env: {
        account: "{{awsEnv.accountId}}",
        region: "{{awsEnv.region}}",
    },
    apiEnv: "production",
    certificateArn: "",
    // TODO: fill in the production IdP values, CloudFormation rejects empty values
    jwtValidation: {
        issuer: "",
        jwksEndpoint: "",
        additionalClaims: [
            {
                name: {{ jwtValidation.audienceClaim | json }},
                format: {{ jwtValidation.audienceFormat | json }},
                values: [],
            },
        ],
    },
    {%- if zoomErrorNotifications %}
    zoomWebhookSecretArn: "{{zoomErrorNotifications.productionSecretArn}}",
    {%- endif %}
});

app.synth();
