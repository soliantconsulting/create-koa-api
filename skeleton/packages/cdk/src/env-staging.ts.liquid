import { App } from "aws-cdk-lib";
import { ApiStack } from "./api-stack.js";

const app = new App();

new ApiStack(app, "{{project.name}}-staging", {
    env: {
        account: "{{awsEnv.accountId}}",
        region: "{{awsEnv.region}}",
    },
    apiEnv: "staging",
    certificateArn: "{{stagingDomain.certificateArn}}",
    jwtValidation: {
        issuer: {{ jwtValidation.issuer | json }},
        jwksEndpoint: {{ jwtValidation.jwksEndpoint | json }},
        additionalClaims: [
            {
                name: {{ jwtValidation.audienceClaim | json }},
                format: {{ jwtValidation.audienceFormat | json }},
                values: {{ jwtValidation.audiences | json }},
            },
        ],
    },
    {%- if zoomErrorNotifications %}
    zoomWebhookSecretArn: "{{zoomErrorNotifications.stagingSecretArn}}",
    {%- endif %}
});

app.synth();
